# Copia este archivo a .env y rellénalo. En producción, pon estas variables en la plataforma de despliegue.

NODE_ENV=development
PORT=3000

# Postgres. En local: postgres://lumi:lumi@localhost:5432/lumi
DATABASE_URL=postgres://lumi:lumi@localhost:5432/lumi

# Firma de los tokens de acceso. En producción, 32 caracteres o más:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Resend (https://resend.com). Vacío en desarrollo: los correos salen en el log.
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend.
MAIL_FROM=Lumi <hola@tudominio.com>

# Orígenes que pueden llamar a la API desde el navegador (la landing), separados por comas.
CORS_ORIGINS=http://localhost:5500
