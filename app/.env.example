# Copia este archivo a app/.env. En EAS, estas variables van por entorno (eas env:create).

# URL del backend. En el iPhone con Expo Go, la IP de tu Mac: http://192.168.x.x:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Clave pública de iOS de RevenueCat (appl_…). Vacía: compras simuladas.
# Solo funciona en un development build o en la versión de la tienda (no en Expo Go).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Dominio de la landing (sin https://), para la tarjeta del resumen semanal. Vacío: no se enseña.
EXPO_PUBLIC_SITE_DOMAIN=
